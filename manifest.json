{
  "manifest_version": 3,
  "name": "DragToWhatever",
  "version": "1.0.1",
  "description": "Transform the current page with a processor and drag the artifact anywhere.",
  "author": "imeavesdropping",
  "permissions": ["storage", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DragToWhatever (OFF)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
